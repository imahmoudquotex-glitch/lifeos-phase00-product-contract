{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve",
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "noEmit": true,
    "incremental": true
  },
  "include": [
    "app/**/*",
    "lib/**/*",
    "next.config.mjs",
    ".next/types/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/route"
    }
  ],
  "exclude": [
    "node_modules"
  ]
}

