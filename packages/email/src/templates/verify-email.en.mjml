<!-- subject: Verify Your LifeOS Email -->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Inter, Arial, sans-serif" />
			<mj-text color="#fafafa" line-height="1.6" />
		</mj-attributes>
	</mj-head>
	<mj-body background-color="#0a0a0a">
		<mj-section background-color="#131313" border-radius="12px" padding="32px 24px">
			<mj-column>
				<mj-text font-size="22px" font-weight="700" align="left" color="#a78bfa">
					✉️ Verify Your Email
				</mj-text>
				<mj-divider border-color="#262626" border-width="1px" padding="12px 0" />
				<mj-text font-size="15px" align="left">
					Thanks {name}! Click below to verify your email and activate your LifeOS account:
				</mj-text>
				<mj-button
					background-color="#7c3aed"
					color="#ffffff"
					font-size="15px"
					font-weight="600"
					border-radius="8px"
					padding="14px 28px"
					href="{verifyUrl}"
					align="left"
				>
					Verify Email →
				</mj-button>
				<mj-text font-size="12px" color="#6b7280" align="left" padding-top="24px">
					This link expires in 24 hours.
					Sent to: {email}
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
