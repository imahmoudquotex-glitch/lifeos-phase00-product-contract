<!-- subject: Reset Your LifeOS Password -->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Inter, Arial, sans-serif" />
			<mj-text color="#fafafa" line-height="1.6" />
		</mj-attributes>
	</mj-head>
	<mj-body background-color="#0a0a0a">
		<mj-section background-color="#131313" border-radius="12px" padding="32px 24px">
			<mj-column>
				<mj-text font-size="22px" font-weight="700" align="left" color="#f59e0b">
					🔑 Password Reset Request
				</mj-text>
				<mj-divider border-color="#262626" border-width="1px" padding="12px 0" />
				<mj-text font-size="15px" align="left">
					You requested a password reset for your LifeOS account. Click the button below within 60 minutes:
				</mj-text>
				<mj-button
					background-color="#ef4444"
					color="#ffffff"
					font-size="15px"
					font-weight="600"
					border-radius="8px"
					padding="14px 28px"
					href="{resetUrl}"
					align="left"
				>
					Reset Password →
				</mj-button>
				<mj-text font-size="12px" color="#6b7280" align="left" padding-top="24px">
					If you didn't request this, ignore this email. The link expires in 60 minutes.
					Sent to: {email}
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
