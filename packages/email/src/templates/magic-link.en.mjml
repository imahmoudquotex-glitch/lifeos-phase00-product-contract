<!-- subject: Your LifeOS Magic Link -->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Inter, Arial, sans-serif" />
			<mj-text color="#fafafa" line-height="1.6" />
		</mj-attributes>
	</mj-head>
	<mj-body background-color="#0a0a0a">
		<mj-section background-color="#131313" border-radius="12px" padding="32px 24px">
			<mj-column>
				<mj-text font-size="22px" font-weight="700" align="left" color="#60a5fa">
					⚡ Your Magic Link
				</mj-text>
				<mj-divider border-color="#262626" border-width="1px" padding="12px 0" />
				<mj-text font-size="15px" align="left">
					Hey {name}, click below to sign in to LifeOS instantly (valid for 15 minutes):
				</mj-text>
				<mj-button
					background-color="#4ade80"
					color="#0a0a0a"
					font-size="15px"
					font-weight="700"
					border-radius="8px"
					padding="14px 28px"
					href="{magicUrl}"
					align="left"
				>
					Sign in now →
				</mj-button>
				<mj-text font-size="12px" color="#6b7280" align="left" padding-top="24px">
					This link is single-use and expires in 15 minutes.
					Sent to: {email}
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
