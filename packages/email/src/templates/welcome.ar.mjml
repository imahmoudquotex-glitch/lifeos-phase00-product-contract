<!-- subject: مرحباً بك في LifeOS، {name} -->
<mjml>
	<mj-head>
		<mj-attributes>
			<mj-all font-family="Tahoma, Cairo, Arial, sans-serif" />
			<mj-text color="#fafafa" line-height="1.6" />
		</mj-attributes>
		<mj-style inline="inline">
			.btn { text-decoration: none; }
		</mj-style>
	</mj-head>
	<mj-body background-color="#0a0a0a">
		<mj-section background-color="#131313" border-radius="12px" padding="32px 24px">
			<mj-column>
				<mj-text font-size="24px" font-weight="700" align="right" color="#4ade80">
					⬡ LifeOS
				</mj-text>
				<mj-divider border-color="#262626" border-width="1px" padding="16px 0" />
				<mj-text font-size="20px" font-weight="600" align="right">
					مرحباً {name} 👋
				</mj-text>
				<mj-text font-size="15px" color="#a3a3a3" align="right">
					حسابك جاهز. ابدأ رحلتك في LifeOS الآن — نظام حياة متكامل للتخطيط والمعرفة والتركيز.
				</mj-text>
				<mj-button
					background-color="#7c3aed"
					color="#ffffff"
					font-size="15px"
					font-weight="600"
					border-radius="8px"
					padding="14px 28px"
					href="{ctaUrl}"
					css-class="btn"
					align="right"
				>
					افتح LifeOS ←
				</mj-button>
				<mj-text font-size="12px" color="#6b7280" align="right" padding-top="24px">
					هذا البريد أُرسل إلى {email}. إذا لم تنشئ حساباً، تجاهل هذه الرسالة.
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
