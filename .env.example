# LifeOS environment variables — development template.
# Copy to .env.local and fill real values. Never commit .env or .env.local.
# Production secrets live in the deploy platform's secret manager.
# CI secrets live in GitHub Actions repository secrets.

# ─── Phase 01 ─────────────────────────────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=postgresql://lifeos:lifeos@localhost:5432/lifeos_dev

# ─── Phase 02 (auth / sessions) ───────────────────────────────────────────────
# SESSION_PEPPER must be exactly 32+ cryptographically random bytes (base64url encoded)
SESSION_PEPPER=replace-with-32-byte-base64url-secret
COOKIE_DOMAIN=localhost
APP_URL=http://localhost:3000
SESSION_COOKIE_NAME=lifeos_sid
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
EMAIL_VERIFICATION_TTL_HOURS=24

# ─── Phase 04 — Vault, CSRF, CSP, OAuth ──────────────────────────────────────
# VAULT_KDF_PEPPER=replace-with-32-byte-base64url-secret
# CSRF_SECRET=replace-with-32-byte-base64url-secret
# CSP_REPORT_URI=/api/_csp-report
# OAUTH_STATE_TTL_MINUTES=10

# ─── Phase 06 (AI gateway — not yet shipped) ─────────────────────────────────
# AI_PROVIDER_API_KEY=replace-when-provider-chosen
